{
  "name": "vilara",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @vilara/web dev",
    "dev:api": "pnpm --filter @vilara/api dev",
    "build": "pnpm --filter @vilara/web build",
    "build:all": "pnpm --filter @vilara/contracts build && pnpm --filter @vilara/api build && pnpm --filter @vilara/web build",
    "lint": "pnpm --filter @vilara/web lint",
    "typecheck": "pnpm --filter @vilara/web typecheck && pnpm --filter @vilara/api typecheck",
    "test": "pnpm --filter @vilara/api test",
    "test:e2e": "pnpm --filter @vilara/web test:e2e"
  }
}
