{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "NIXPACKS", "buildCommand": "cd .. && pnpm install --frozen-lockfile && pnpm --filter @vilara/api build" },
  "deploy": { "startCommand": "node dist/index.js", "healthcheckPath": "/api/health", "healthcheckTimeout": 120, "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 5 }
}
